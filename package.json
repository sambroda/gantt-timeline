{
  "name": "@sambroda/gantt-timeline",
  "version": "1.0.5",
  "description": "Reusable React SVG Gantt timeline with configurable date markers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test:local": "npm link && cd demo && npm link @sambroda/gantt-timeline",
    "lint": "eslint src demo",
    "prepare": "husky",
    "lint:fix": "eslint src demo --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"demo/**/*.{js,jsx,css,json,html}\" \"*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"demo/**/*.{js,jsx,css,json,html}\" \"*.{js,json,md,yml,yaml}\""
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0",
    "prettier": "^3.6.2",
    "lint-staged": "^16.2.7"
  },
  "author": {
    "name": "Sam Broda",
    "url": "https://github.com/sambroda"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sambroda/gantt-timeline.git"
  },
  "homepage": "https://github.com/sambroda/gantt-timeline#readme",
  "bugs": {
    "url": "https://github.com/sambroda/gantt-timeline/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "gantt",
    "timeline",
    "svg",
    "date",
    "visualization"
  ],
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
